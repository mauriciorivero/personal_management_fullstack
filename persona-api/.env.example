# =====================================================================
# .env.example  -  Plantilla de variables de entorno
# ---------------------------------------------------------------------
# Plantilla publica. Copiala a .env y completa los valores reales:
#   cp .env.example .env
# Este archivo SI se sube a git; .env NO.
# =====================================================================

# ---------- Servidor HTTP ----------
PUERTO=3000
NODE_ENV=development

# ---------- Base de datos MySQL ----------
DB_HOST=localhost
DB_PUERTO=3306
DB_USUARIO=pm_user
DB_CLAVE=cambia_esta_clave
DB_NOMBRE=personal_management

# Numero maximo de conexiones simultaneas en el pool.
DB_LIMITE_CONEXIONES=10

# ---------- CORS ----------
# Origenes del frontend autorizados a consumir la API, separados por coma.
ORIGENES_PERMITIDOS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
